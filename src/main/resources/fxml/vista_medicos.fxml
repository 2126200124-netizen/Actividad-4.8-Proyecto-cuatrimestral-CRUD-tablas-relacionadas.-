<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controladores.VistaMedicosController" spacing="10">
    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <Label text="Gestión de Médicos" styleClass="titulo"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre(s) del médico" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Apellidos" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtApellidos" promptText="Apellidos del médico" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Hospital" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbHospital" promptText="Elige un hospital" maxWidth="350"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Estatus" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbEstatus" promptText="Elige el estatus" maxWidth="350"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Especialidades" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <FlowPane fx:id="panelEspecialidades" hgap="14" vgap="6"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Foto" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <Button text="Elegir foto" onAction="#elegirFoto"/>
            <Label fx:id="lblFoto" text="Sin foto"/>
            <ImageView fx:id="imgFoto" fitWidth="100" fitHeight="100" preserveRatio="true"
                       style="-fx-border-color: #C3CEDA; -fx-border-radius: 6;"/>
        </HBox>
    </GridPane>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="boton-principal"/>
        <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" disable="true"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" disable="true"/>
        <Button text="Limpiar" onAction="#limpiarFormulario"/>
    </HBox>

    <Label text="Médicos registrados" styleClass="subtitulo"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefHeight="200">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="250"/>
            <TableColumn fx:id="colHospital" text="Hospital" prefWidth="240"/>
            <TableColumn fx:id="colEstatus" text="Estatus" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
