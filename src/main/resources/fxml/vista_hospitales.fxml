<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controladores.VistaHospitalesController" spacing="10">
    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <Label text="Gestión de Hospitales" styleClass="titulo"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

    
        <ScrollPane fitToWidth="true" prefWidth="580" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="10">
                    <padding>
                        <Insets right="10"/>
                    </padding>

                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" promptText="Nombre del hospital" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Dirección" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="txtDireccion" prefRowCount="2" promptText="Calle, número, colonia..."
                                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Estado" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbEstado" promptText="Elige un estado" maxWidth="300"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Teléfono" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTelefono" promptText="10 dígitos" maxWidth="300"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Estatus" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbEstatus" promptText="Elige el estatus" maxWidth="300"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Servicios" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <FlowPane fx:id="panelServicios" hgap="14" vgap="6"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Foto" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <Button text="Elegir foto" onAction="#elegirFoto"/>
                            <Label fx:id="lblFoto" text="Sin foto"/>
                            <ImageView fx:id="imgFoto" fitWidth="70" fitHeight="70" preserveRatio="true"
                                       style="-fx-border-color: #C3CEDA; -fx-border-radius: 6;"/>
                        </HBox>
                    </GridPane>

                    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="boton-principal"/>
                        <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" disable="true"/>
                        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" disable="true"/>
                        <Button text="Limpiar" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>

        
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Hospitales registrados" styleClass="subtitulo"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colEntidad" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
                    <TableColumn fx:id="colEstatus" text="Estatus" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

    </HBox>
</VBox>